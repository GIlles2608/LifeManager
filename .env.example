# Copy this file to .env and fill in your values
# Never commit .env to git

# --- Database ---
DB_DRIVER=postgresql+psycopg2
DB_HOST=localhost
DB_PORT=5432
DB_NAME=lifemanager
DB_USER=postgres
DB_PASSWORD=root

# Constructed automatically by config.py:
# DATABASE_URL=postgresql+psycopg2://postgres:root@localhost:5432/lifemanager

# --- Application ---
APP_ENV=development          # development | production
APP_LOCALE=fr_FR
APP_CURRENCY=EUR

# --- External APIs ---
OFF_API_BASE=https://world.openfoodfacts.org/api/v2
OFF_USER_AGENT=LifeManager/0.1 (personal-app)
